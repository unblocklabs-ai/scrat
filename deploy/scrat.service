[Unit]
Description=Scrat 2 GitHub agent harness
After=network-online.target scrat-docker.service
Wants=network-online.target
Requires=scrat-docker.service

[Service]
WorkingDirectory=/home/bek/.local/share/scrat-v2/current
Environment=PATH=/home/bek/.local/share/scrat/runtime/node-v22.23.1-linux-x64/bin:/home/bek/.local/share/scrat-v2/bin:/home/bek/.local/share/scrat/runtime/docker:/usr/local/bin:/usr/bin:/bin
Environment=DOCKER_HOST=unix:///run/user/1000/scrat-docker.sock
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=SCRAT_REPOSITORY_PATH=/home/bek/.local/share/scrat-v2/repository
ExecStart=/usr/bin/flock --no-fork --exclusive --nonblock /home/bek/.local/share/scrat-v2/data/worker.lock /bin/sh -c 'node --env-file=.env src/recover-active.ts && exec node --env-file=.env src/serve.ts'
Restart=on-failure
OOMPolicy=continue
MemoryMax=20G
RestartSec=10
TimeoutStopSec=infinity
KillMode=mixed

[Install]
WantedBy=default.target
