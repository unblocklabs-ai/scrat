{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/{run-next,recover-active}.ts",
    "workflows/*/run.ts",
    "deploy/prepare-tools.mjs"
  ],
  "ignoreBinaries": ["rg", "mkfifo"],
  "ignoreDependencies": ["lighthouse", "playwright-core"],
  "ignoreExportsUsedInFile": { "type": true },
  "project": ["src/**/*.ts", "workflows/**/*.ts", "test/**/*.mjs", "deploy/**/*.mjs"]
}
