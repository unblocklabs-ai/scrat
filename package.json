{
  "name": "scrat",
  "version": "2.0.41",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "fetch": "node --env-file=.env src/fetch.ts",
    "enqueue": "node --env-file=.env src/enqueue.ts",
    "run-next": "node --env-file=.env src/run-next.ts",
    "work": "node --env-file=.env src/work.ts",
    "sync": "node --env-file=.env src/sync.ts",
    "retry": "node --env-file=.env src/retry.ts",
    "cleanup": "node --env-file=.env src/cleanup.ts",
    "recover": "node --env-file=.env src/recover.ts",
    "serve": "node --env-file=.env src/serve.ts",
    "test": "SCRAT_TEST_CONCURRENCY=${SCRAT_TEST_CONCURRENCY:-4} node --test test/integration.test.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "knip": "knip"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@octokit/auth-app": "^8.3.1",
    "drizzle-orm": "1.0.0-rc.4",
    "octokit": "^5.0.5",
    "pino": "^10.4.0",
    "typebox": "1.3.27",
    "undici": "8.10.2",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "playwright-core": "^1.50.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "drizzle-kit": "1.0.0-rc.4",
    "knip": "6.42.1",
    "typescript": "5.9.3"
  }
}
