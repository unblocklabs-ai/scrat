{
  "harness": {
    "maxConcurrency": 6,
    "maxConcurrentValidations": 3,
    "commandTimeoutSeconds": 3600,
    "commandOutputTailBytes": 65536,
    "maxOutputBytes": 16777216,
    "gitNetworkTimeoutSeconds": 600,
    "idlePollSeconds": 30,
    "agentTimeoutSeconds": 3600,
    "drainTimeoutSeconds": 900,
    "retryJitter": 0.1,
    "corrections": { "incomplete": 1, "validation": 2, "format": 2 },
    "logLevel": "info"
  },
  "github": {
    "repository": "unblocklabs-ai/agent-platform",
    "repositoryPath": "../agent-platform",
    "baseBranch": "main",
    "auth": "app",
    "botLogin": "scrat-unblock[bot]",
    "botName": "Scrat",
    "appId": 5017746,
    "installationId": 163420479,
    "fetchIntervalSeconds": 300,
    "readConcurrency": 4
  },
  "bindings": {},
  "context": {
    "inlinePaths": 200,
    "historyRuns": 10,
    "historyBytes": 65536
  },
  "tools": {
    "readBytes": { "default": 32768, "max": 65536 },
    "git": { "maxCommits": 200, "maxScopeBytes": 1048576 },
    "http": { "timeoutSeconds": 30, "maxRequestBytes": 65536 },
    "browser": { "steps": 40, "sessionSeconds": 300, "stepSeconds": 30 }
  },
  "slack": {
    "enabled": false,
    "channel": "",
    "maxRetryAfterSeconds": 30
  },
  "workspace": {
    "sandbox": false,
    "commandMemoryMax": null,
    "packageStore": null,
    "layout": "worktree",
    "environment": {
      "VITEST_MAX_WORKERS": "1"
    },
    "prepare": [
      ["pnpm", "install", "--frozen-lockfile"],
      ["pnpm", "prisma-typegen"]
    ],
    "database": {
      "image": "postgres:16-alpine",
      "environment": ["DATABASE_URL", "TEST_DATABASE_URL"],
      "migrate": ["pnpm", "db:migrate"]
    },
    "validate": [
      ["env", "TEST_DATABASE_URL=", "pnpm", "verify"],
      ["pnpm", "test:db:ci"]
    ],
    "heavyCommands": [
      "^pnpm( -\\S+)*( run)? (verify|lint|knip|type-check|build|test:coverage|test:e2e\\S*)( |$)",
      "^(pnpm (exec )?|npx )?tsc( |$)",
      "^(pnpm (exec )?|npx )?knip( |$)",
      "^(pnpm (exec )?|npx )?eslint +(\\.|--max-warnings)",
      "^(pnpm (exec )?|npx )?playwright (test|show-report|open|codegen)( |$)"
    ]
  },
  "providers": {
    "codex-lb": {
      "baseUrl": "http://192.168.1.27:2455/backend-api/codex",
      "api": "openai-responses",
      "apiKey": "${CODEX_LB_API_KEY}",
      "authHeader": true,
      "models": [
        {
          "id": "deepseek/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "reasoning": true,
          "contextWindow": 1000000,
          "maxTokens": 32768
        },
        {
          "id": "gpt-6.1-sol",
          "name": "GPT-6.1 Sol",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          },
          "contextWindow": 272000,
          "maxTokens": 128000
        }
      ]
    }
  }
}
