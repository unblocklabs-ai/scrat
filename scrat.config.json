  "tools": {
    "readBytes": { "default": 32768, "max": 65536 },
    "readDedupMinBytes": 2048,
    "git": {
      "maxCommits": 200,
      "maxScopeBytes": 1048576,
      "generatedDiffBytes": 4096,
      "generatedPaths": [
        "(?:^|/)(?:pnpm-lock\\.yaml|package-lock\\.json|yarn\\.lock|bun\\.lockb?|Cargo\\.lock|Gemfile\\.lock|poetry\\.lock|uv\\.lock)$",
        "(?:\\.min\\.(?:js|css)|\\.map|\\.snap)$",
        "^assets/(?:main|index|customer-portal)-[A-Za-z0-9_-]+\\.(?:js|css)$"
      ]
    },
    "grep": {
      "review": "deterministic",
      "change": "deterministic",
      "inlineBytes": 10240
    },
    "http": { "timeoutSeconds": 30, "maxRequestBytes": 65536 },
    "browser": { "steps": 40, "sessionSeconds": 300, "navigationSeconds": 30, "actionSeconds": 12, "textCaptureBytes": 524288, "domScoping": true, "sitemapSamplesPerGroup": 5, "sitemapMaxGroups": 20, "defaultViewport": "desktop", "viewports": { "desktop": { "width": 1280, "height": 800 }, "mobile": { "width": 390, "height": 844 } } },
    "search": { "pageSize": 20, "excerptChars": 300, "maxQueryLength": 256 },
    "codemode": { "review": true, "change": true, "mode": "on", "inlineBudget": 3000, "maxWorkers": 4, "models": false },
    "redactionMarginBytes": 4096
  },
  "d1": {
    "enabled": false,
    "url": "https://codex.unblocklabs.ai/v1/decisions",
    "extractionsUrl": null,
    "model": "liquid/d1.2-ultra",
    "tokenEnv": "CODEX_LB_API_KEY",
    "certPath": null,
    "timeoutMs": 2500,
    "maxRetries": 2,
    "retryBaseDelayMs": 250,
    "retryJitterMs": 150,
    "retryReserveMs": 300,
    "circuitBreakerThreshold": 2,
    "circuitBreakerCooldownMs": 30000,
    "maxWaves": 1,
    "waveMaxChars": 12000,
    "waveMaxItems": 18,
    "maxCandidateChunks": 12,
    "waveConcurrency": 2,
    "maxConcurrency": 4,
    "scoreThreshold": 0.3,
    "bash": { "minChars": 4096, "maxOutputChars": 12000 },
    "validation": { "minChars": 4096, "maxOutputChars": 12000 },
    "browserText": { "minChars": 6144, "maxOutputChars": 6000 },
    "history": { "minChars": 6144, "maxOutputChars": 6000 },
    "failureBlocks": { "enabled": true, "skipD1OnMatch": true, "maxBlocks": 12, "contextLines": 8 },
    "navigation": { "enabled": true, "maxFiles": 25, "maxHunks": 18, "maxHunkChars": 900, "minDiffPaths": 3, "minBodyChars": 800, "extractMinConfidence": 0.5, "topFocusFiles": 8, "maxStateChars": 12000, "maxTitleChars": 300, "gitTimeoutMs": 5000 }
  },
  "storefront": {
    "enabled": false,
    "store": "",
