{
  "harness": {
    "maxConcurrency": 2,
    "logLevel": "info"
  },
  "github": {
    "repository": "unblocklabs-ai/agent-platform",
    "repositoryPath": "../agent-platform",
    "baseBranch": "main",
    "botLogin": "scrat-unblock[bot]",
    "appId": 5017746,
    "installationId": 163420479,
    "fetchIntervalSeconds": 300
  },
  "workspace": {
    "prepare": [
      ["pnpm", "install", "--frozen-lockfile"],
      ["pnpm", "prisma-typegen"]
    ],
    "database": {
      "image": "postgres:16-alpine",
      "environment": ["DATABASE_URL", "TEST_DATABASE_URL"],
      "migrate": ["pnpm", "db:migrate"]
    },
    "validate": [
      ["env", "TEST_DATABASE_URL=", "pnpm", "verify"],
      ["pnpm", "test:db:ci"]
    ]
  },
  "providers": {
    "codex-lb": {
      "baseUrl": "http://192.168.1.27:2455/backend-api/codex",
      "api": "openai-responses",
      "apiKey": "${CODEX_LB_API_KEY}",
      "authHeader": true,
      "models": [
        {
          "id": "gpt-6.1-sol",
          "name": "GPT-6.1 Sol",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          },
          "contextWindow": 272000,
          "maxTokens": 128000
        }
      ]
    }
  },
  "actions": {
    "review_issue": {
      "skill": "skills/review_issue/SKILL.md",
      "provider": "codex-lb",
      "model": "gpt-6.1-sol",
      "thinkingLevel": "high"
    },
    "review_pr": {
      "skill": "skills/review_pr/SKILL.md",
      "provider": "codex-lb",
      "model": "gpt-6.1-sol",
      "thinkingLevel": "high"
    },
    "implement": {
      "skill": "skills/implement/SKILL.md",
      "provider": "codex-lb",
      "model": "gpt-6.1-sol",
      "thinkingLevel": "high"
    },
    "resolve_conflicts": {
      "skill": "skills/resolve_conflicts/SKILL.md",
      "provider": "codex-lb",
      "model": "gpt-6.1-sol",
      "thinkingLevel": "high"
    },
    "address_pr_feedback": {
      "skill": "skills/address_pr_feedback/SKILL.md",
      "provider": "codex-lb",
      "model": "gpt-6.1-sol",
      "thinkingLevel": "high"
    }
  }
}
