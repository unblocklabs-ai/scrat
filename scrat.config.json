  "workspace": {
    "sandbox": false,
    "commandMemoryMax": null,
    "packageStore": null,
    "environment": {
      "VITEST_MAX_WORKERS": "1"
    },
    "prepare": [
      ["pnpm", "install", "--frozen-lockfile"],
      ["pnpm", "prisma-typegen"]
    ],
    "prepareReview": null,
    "prepareInputs": [
      "(?:^|/)(?:package\\.json|pnpm-lock\\.yaml|pnpm-workspace\\.yaml|package-lock\\.json|yarn\\.lock|bun\\.lockb?|\\.npmrc|prisma\\.config\\.[cm]?[jt]s)$",
      "(?:^|/)(?:prisma|patches)/"
    ],
    "database": {
      "image": "postgres:16-alpine",
      "environment": ["DATABASE_URL", "TEST_DATABASE_URL"],
      "migrate": ["pnpm", "db:migrate"]
    },
    "validate": [
      ["pnpm", "knip"],
      ["pnpm", "build:cli"],
      ["pnpm", "test:cli"],
      ["pnpm", "type-check"],
      ["pnpm", "lint"],
      ["pnpm", "test:db:ci"],
      ["env", "TEST_DATABASE_URL=", "pnpm", "test"]
    ],
    "heavyCommands": [
      "^pnpm( -\\S+)*( run)? (verify|lint|knip|type-check|build|test:coverage|test:e2e\\S*)( |$)",
      "^(pnpm (exec )?|npx )?tsc( |$)",
      "^(pnpm (exec )?|npx )?knip( |$)",
      "^(pnpm (exec )?|npx )?eslint +(\\.|--max-warnings)",
      "^(pnpm (exec )?|npx )?playwright (test|show-report|open|codegen)( |$)"
    ]
