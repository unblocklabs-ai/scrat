{
  "harness": {
    "maxConcurrency": 6,
    "maxConcurrentValidations": 3,
    "commandTimeoutSeconds": 3600,
    "agentTimeoutSeconds": 3600,
    "logLevel": "info"
  },
  "github": {
    "repository": "unblocklabs-ai/agent-platform",
    "repositoryPath": "../agent-platform",
    "baseBranch": "main",
    "auth": "app",
    "botLogin": "scrat-unblock[bot]",
    "botName": "Scrat",
    "appId": 5017746,
    "installationId": 163420479,
    "fetchIntervalSeconds": 300
  },
  "workspace": {
    "environment": {
      "VITEST_MAX_WORKERS": "1"
    },
    "prepare": [
      ["pnpm", "install", "--frozen-lockfile"],
      ["pnpm", "prisma-typegen"]
    ],
    "database": {
      "image": "postgres:16-alpine",
      "environment": ["DATABASE_URL", "TEST_DATABASE_URL"],
      "migrate": ["pnpm", "db:migrate"]
    },
    "validate": [
      ["env", "TEST_DATABASE_URL=", "pnpm", "verify"],
      ["pnpm", "test:db:ci"]
    ],
    "heavyCommands": [
      "^pnpm( -\\S+)*( run)? (verify|lint|knip|type-check|build|test:coverage|test:e2e\\S*)( |$)",
      "^(pnpm (exec )?|npx )?tsc( |$)",
      "^(pnpm (exec )?|npx )?knip( |$)",
      "^(pnpm (exec )?|npx )?eslint +(\\.|--max-warnings)",
      "^(pnpm (exec )?|npx )?playwright (test|show-report|open|codegen)( |$)"
    ]
  },
  "providers": {
    "codex-lb": {
      "baseUrl": "http://192.168.1.27:2455/backend-api/codex",
      "api": "openai-responses",
      "apiKey": "${CODEX_LB_API_KEY}",
      "authHeader": true,
      "models": [
        {
          "id": "deepseek/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "reasoning": true,
          "contextWindow": 1000000,
          "maxTokens": 32768
        },
        {
          "id": "gpt-6.1-sol",
          "name": "GPT-6.1 Sol",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          },
          "contextWindow": 272000,
          "maxTokens": 128000
        }
      ]
    }
  },
  "actions": {
    "review_issue": {
      "priority": 10,
      "skill": "skills/review_issue/SKILL.md",
      "provider": "codex-lb",
      "model": "gpt-6.1-sol",
      "thinkingLevel": "high"
    },
    "review_pr": {
      "priority": 100,
      "reviewers": [
        { "provider": "codex-lb", "model": "gpt-6.1-sol", "thinkingLevel": "high" },
        { "provider": "codex-lb", "model": "deepseek/deepseek-v4.1-flash", "thinkingLevel": "high" }
      ],
      "skill": "skills/review_pr/SKILL.md",
      "provider": "codex-lb",
      "model": "gpt-6.1-sol",
      "thinkingLevel": "high"
    },
    "implement": {
      "priority": 60,
      "skill": "skills/implement/SKILL.md",
      "provider": "codex-lb",
      "model": "gpt-6.1-sol",
      "thinkingLevel": "high"
    },
    "resolve_conflicts": {
      "priority": 60,
      "skill": "skills/resolve_conflicts/SKILL.md",
      "provider": "codex-lb",
      "model": "gpt-6.1-sol",
      "thinkingLevel": "high"
    },
    "address_pr_feedback": {
      "priority": 60,
      "skill": "skills/address_pr_feedback/SKILL.md",
      "provider": "codex-lb",
      "model": "gpt-6.1-sol",
      "thinkingLevel": "high"
    },
    "address_review": {
      "priority": 60,
      "skill": "skills/address_review/SKILL.md",
      "provider": "codex-lb",
      "model": "gpt-6.1-sol",
      "thinkingLevel": "high",
      "maxSelfRepairs": 2,
      "exhaustedLabel": "Scrat repair exhausted"
    },
    "review_base_change": {
      "enabled": false,
      "agent": "single",
      "priority": 30,
      "skill": "skills/review_change/SKILL.md",
      "provider": "codex-lb",
      "model": "gpt-6.1-sol",
      "thinkingLevel": "high",
      "reviewers": [],
      "branch": "main",
      "channel": "",
      "maxRangeCommits": 50,
      "startMessage": "{{bot}}: `{{branch}}` moved to <{{url}}|{{short_sha}}> by {{author}} ({{count}} commit(s)): {{title}}. Reviewing the change."
    }
  }
}
