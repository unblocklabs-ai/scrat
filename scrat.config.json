{
  "harness": {
    "maxConcurrency": 6,
    "maxConcurrentValidations": 3,
    "commandTimeoutSeconds": 3600,
    "commandOutputTailBytes": 65536,
    "maxOutputBytes": 16777216,
    "gitNetworkTimeoutSeconds": 600,
    "idlePollSeconds": 30,
    "agentTimeoutSeconds": 3600,
    "drainTimeoutSeconds": 900,
    "maxStderrBytes": 8192,
    "logTargetChars": 200,
    "logErrorChars": 300,
    "reviewCacheLimit": 256,
    "treeCacheLimit": 8,
    "databaseHealthRetries": 30,
    "databaseHealthIntervalSeconds": 1,
    "databaseHealthTimeoutSeconds": 3,
    "databaseLogTailLines": 50,
    "sqliteBusyTimeoutMs": 5000,
    "workerErrorDelaySeconds": 1,
    "sandboxPreflightSeconds": 30,
    "retryJitter": 0.1,
    "crashRequeues": 3,
    "corrections": { "incomplete": 1, "validation": 2, "format": 2 },
    "agentRetry": { "maxRetries": 3, "baseDelayMs": 2000 },
    "transientErrors": ["stream_incomplete"],
    "logLevel": "info"
  },
  "github": {
    "repository": "unblocklabs-ai/agent-platform",
    "repositoryPath": "../agent-platform",
    "baseBranch": "main",
    "auth": "app",
    "botLogin": "scrat-unblock[bot]",
    "botName": "Scrat",
    "appId": 5017746,
    "installationId": 163420479,
    "fetchIntervalSeconds": 300,
    "readConcurrency": 4,
    "maxCachedResponses": 2000,
    "maxCachedChars": 67108864,
    "rateLimitLowFraction": 0.1
  },
  "bindings": {},
  "context": {
    "inlinePaths": 200,
    "historyRuns": 10,
    "historyBytes": 65536
  },
  "relevance": {
    "ignoredPaths": []
  },
  "tools": {
    "readBytes": { "default": 32768, "max": 65536 },
    "git": { "maxCommits": 200, "maxScopeBytes": 1048576 },
    "http": { "timeoutSeconds": 30, "maxRequestBytes": 65536 },
    "browser": { "steps": 40, "sessionSeconds": 300, "navigationSeconds": 30, "actionSeconds": 12, "defaultViewport": "desktop", "viewports": { "desktop": { "width": 1280, "height": 800 }, "mobile": { "width": 390, "height": 844 } } },
    "search": { "pageSize": 20, "excerptChars": 300, "maxQueryLength": 256 },
    "redactionMarginBytes": 4096
  },
  "storefront": {
    "enabled": false,
    "store": "",
    "publicHost": "",
    "model": { "provider": "codex-lb", "model": "gpt-6.1-terra", "thinkingLevel": "high" },
    "siteMapMaxAgeDays": 30,
    "siteMapRetryHours": 24,
    "siteMapPaths": "^(templates|layout)/",
    "auditPaths": [],
    "screenshotRetentionDays": 14,
    "devices": ["desktop", "mobile"],
    "limits": { "browsers": 2, "browserSteps": 80, "browserSeconds": 1200, "confirmationRuns": 1, "regressionMaxGrade": "C" },
    "loggie": { "url": "https://app.loggie.ai", "slug": "", "timeoutSeconds": 60 },
    "preview": {
      "themeNamePrefix": "scrat/",
      "themePaths": "^(?:assets|blocks|config|layout|locales|sections|snippets|templates|templates/customers|templates/metaobject)/[^/]+$",
      "processingWaitSeconds": 300,
      "processingPollSeconds": 5,
      "filesPageSize": 250,
      "filenamesPerRequest": 50,
      "uploadBatch": 50,
      "uploadBatchBytes": 8388608,
      "requestTimeoutSeconds": 180
    },
    "lighthouse": { "runs": 2, "pages": ["/"], "timeoutSeconds": 600 }
  },
  "slack": {
    "enabled": false,
    "channel": "",
    "maxRetryAfterSeconds": 30,
    "minimumGapMs": 1000,
    "maxErrorLength": 300,
    "maxTextLength": 3000
  },
  "workspace": {
    "sandbox": false,
    "commandMemoryMax": null,
    "packageStore": null,
    "environment": {
      "VITEST_MAX_WORKERS": "1"
    },
    "prepare": [
      ["pnpm", "install", "--frozen-lockfile"],
      ["pnpm", "prisma-typegen"]
    ],
    "database": {
      "image": "postgres:16-alpine",
      "environment": ["DATABASE_URL", "TEST_DATABASE_URL"],
      "migrate": ["pnpm", "db:migrate"]
    },
    "validate": [
      ["env", "TEST_DATABASE_URL=", "pnpm", "verify"],
      ["pnpm", "test:db:ci"]
    ],
    "heavyCommands": [
      "^pnpm( -\\S+)*( run)? (verify|lint|knip|type-check|build|test:coverage|test:e2e\\S*)( |$)",
      "^(pnpm (exec )?|npx )?tsc( |$)",
      "^(pnpm (exec )?|npx )?knip( |$)",
      "^(pnpm (exec )?|npx )?eslint +(\\.|--max-warnings)",
      "^(pnpm (exec )?|npx )?playwright (test|show-report|open|codegen)( |$)"
    ]
  },
  "providers": {
    "codex-lb": {
      "baseUrl": "http://192.168.1.27:2455/backend-api/codex",
      "api": "openai-responses",
      "apiKey": "${CODEX_LB_API_KEY}",
      "authHeader": true,
      "models": [
        {
          "id": "deepseek/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1048576,
          "maxTokens": 393216
        },
        {
          "id": "gpt-6.1-sol",
          "name": "GPT-6.1 Sol",
          "reasoning": true,
          "input": ["text", "image"],
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          },
          "contextWindow": 500000,
          "maxTokens": 500000
        },
        {
          "id": "gpt-6.1-terra",
          "name": "GPT-6.1 Terra",
          "reasoning": true,
          "input": ["text", "image"],
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          },
          "contextWindow": 500000,
          "maxTokens": 500000
        }
      ]
    }
  }
}
